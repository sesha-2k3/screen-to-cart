# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/screen_to_cart

# LLM provider (free tier)
GROQ_API_KEY=
IDENTIFY_VISION_MODEL=groq:qwen/qwen3.8-27b
DISAMBIGUATE_MODEL=groq:openai/gpt-oss-120b
REFINE_MODEL=groq:openai/gpt-oss-20b
# Leave empty to use REFINE_MODEL
SPONSORSHIP_MODEL=groq:openai/gpt-oss-20b
LLM_MODE=live            # live | record | replay
# Tier 2 runs when Tier 1's top confidence is below this
TIER2_CONFIDENCE_THRESHOLD=0.7
# Tokens per minute per model, for the rate limiter (check console.groq.com/settings/limits)
GROQ_TPM_LIMIT=8000
# true saves each /identify request (sharpest frame + context) to backend/eval/captures/
SAVE_EVAL_CAPTURES=false

# Later: ANTHROPIC_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Retailers
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
BESTBUY_API_KEY=

# Embeddings
SIGLIP_MODEL=google/siglip-base-patch16-224

# CORS: comma-separated extension origins, e.g. chrome-extension://<extension-id>
CORS_ALLOWED_ORIGINS=
